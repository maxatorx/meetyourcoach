{% extends 'layout.html.twig' %}

{% block title %}Catalogue · MeetYourCoach{% endblock %}

{% block content %}
<section class="myc-hero">
    <div class="row align-items-center gy-4">
        <div class="col-lg-8">
            <p class="badge badge-rounded badge-cours text-uppercase mb-3">{{ trans('home.hero.badge') }}</p>
            <h1 class="display-5 mb-3">{{ trans('home.hero.title') }}</h1>
            <p class="mb-4">{{ trans('home.hero.subtitle') }}</p>
            <div class="d-flex flex-wrap gap-2">
                {% if not is_logged_in %}
                    <a href="{{ path('register') }}" class="btn btn-primary btn-lg px-4">{{ trans('home.hero.cta_primary') }}</a>
                {% endif %}
                <a href="{{ path('recherche') }}" class="btn btn-outline-primary btn-lg px-4">{{ trans('home.hero.cta_secondary') }}</a>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="bg-white rounded-4 p-4 shadow-sm h-100">
                <p class="text-uppercase small text-muted mb-1">{{ trans('home.hero.reasons_title') }}</p>
                <ul class="list-unstyled mb-0">
                    <li class="d-flex align-items-center mb-2"><span class="badge badge-rounded badge-atelier me-2">1</span>{{ trans('home.hero.reasons.1') }}</li>
                    <li class="d-flex align-items-center mb-2"><span class="badge badge-rounded badge-atelier me-2">2</span>{{ trans('home.hero.reasons.2') }}</li>
                    <li class="d-flex align-items-center"><span class="badge badge-rounded badge-atelier me-2">3</span>{{ trans('home.hero.reasons.3') }}</li>
                </ul>
            </div>
        </div>
    </div>
</section>
<div class="myc-filter-bar d-flex flex-wrap justify-content-between align-items-center">
    <div class="d-flex flex-wrap gap-2">
        <a href="{{ path('/', {'type':'all'}) }}" class="btn btn-sm {{ current_type == 'all' ? 'btn-primary active' : 'btn-outline-primary' }}">{{ trans('home.filters.all') }}</a>
        <a href="{{ path('/', {'type':'cours'}) }}" class="btn btn-sm {{ current_type == 'cours' ? 'btn-primary active' : 'btn-outline-primary' }}">{{ trans('home.filters.courses') }}</a>
        <a href="{{ path('/', {'type':'atelier'}) }}" class="btn btn-sm {{ current_type == 'atelier' ? 'btn-primary active' : 'btn-outline-primary' }}">{{ trans('home.filters.workshops') }}</a>
    </div>
    <a class="btn btn-outline-primary btn-sm" href="{{ path('recherche') }}">{{ trans('navigation.advanced_search') }}</a>
</div>
<h2 class="myc-section-title">{{ trans('home.section_title') }}</h2>
{% set decimal_sep = current_locale == 'en' ? '.' : ',' %}
{% set thousand_sep = current_locale == 'en' ? ',' : ' ' %}
{% set date_format = current_locale == 'en' ? 'm/d/Y h:i A' : 'd/m/Y H:i' %}

<div class="row g-4">
    {% for item in items %}
        <div class="col-md-4">
            <div class="card myc-card h-100">
                {% if item.imageUrl %}
                    {% set card_image = asset(item.imageUrl) %}
                {% else %}
                    {% set card_image = 'https://via.placeholder.com/640x360?text=MeetYourCoach' %}
                {% endif %}
                <img src="{{ card_image }}" class="card-img-top" alt="{{ item.title }}">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        {% set type_label = trans('content.type.' ~ item.type) %}
                        <span class="badge badge-rounded {{ item.type == 'cours' ? 'badge-cours' : 'badge-atelier' }}">{{ type_label }}</span>
                        {% set formatted_price = item.price|number_format(2, decimal_sep, thousand_sep) %}
                        <span class="myc-price">{{ trans('home.card.price', {'price': formatted_price}) }}</span>
                    </div>
                    <h2 class="h5">{{ item.title }}</h2>
                    <p class="text-muted mb-1">{{ item.trainer }}</p>
                    {% if item.level %}<p class="small mb-2 text-muted">{{ trans('home.card.level', {'level': item.level}) }}</p>{% endif %}
                    {% if item.scheduledAt %}<p class="small mb-2 text-muted">{{ trans('home.card.date', {'date': item.scheduledAt|date(date_format) }) }}</p>{% endif %}
                    <div class="mt-auto">
                        <a class="btn btn-outline-primary w-100" href="{{ path(item.type ~ '/' ~ item.id) }}">{{ trans('home.card.view') }}</a>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <p class="text-center">{{ trans('home.empty') }}</p>
    {% endfor %}
</div>
<nav class="mt-4">
    <ul class="pagination">
        <li class="page-item {{ page <= 1 ? 'disabled' : '' }}">
            <a class="page-link" href="{{ path('/', {'type': current_type, 'page': page - 1}) }}">{{ trans('pagination.prev') }}</a>
        </li>
        <li class="page-item">
            <a class="page-link" href="{{ path('/', {'type': current_type, 'page': page + 1}) }}">{{ trans('pagination.next') }}</a>
        </li>
    </ul>
</nav>
{% endblock %}
