{% extends 'layout.html.twig' %}

{% block title %}{{ trans('trainer.title') }} · MeetYourCoach{% endblock %}

{% block content %}
<h1 class="h3 mb-4">{{ trans('trainer.title') }}</h1>
{% set date_format = current_locale == 'en' ? 'm/d/Y h:i A' : 'd/m/Y H:i' %}
<div class="row g-4">
    <div class="col-lg-6">
        <form method="post" action="{{ path('formateur') }}" class="trainer-form" enctype="multipart/form-data">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            {% include 'trainer/form_cours.html.twig' with { course: edit_course } %}
        </form>
    </div>
    <div class="col-lg-6">
        <form method="post" action="{{ path('formateur') }}" class="trainer-form" enctype="multipart/form-data">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            {% include 'trainer/form_atelier.html.twig' with { workshop: edit_workshop } %}
        </form>
    </div>
</div>
<hr class="my-4">
<div class="row g-4">
    <div class="col-lg-6">
        <h2 class="h5">{{ trans('trainer.lists.courses') }}</h2>
        <ul class="list-group">
            {% for course in courses %}
                <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                    <div class="flex-grow-1">
                        <a class="text-decoration-none" href="{{ path('cours/' ~ course.id) }}">
                            {{ course.title }}
                        </a>
                        {% set level_key = 'trainer.forms.course.levels.' ~ course.level %}
                        <div class="small text-muted">{{ trans(level_key) }}</div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary text-uppercase">{{ course.status }}</span>
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('formateur', {'edit_course': course.id}) }}">{{ trans('trainer.lists.edit') }}</a>
                        <form method="post" action="{{ path('formateur') }}" onsubmit="return confirm('{{ trans('trainer.lists.confirm_course') }}');">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                            <input type="hidden" name="action" value="delete_course">
                            <input type="hidden" name="course_id" value="{{ course.id }}">
                            <button class="btn btn-sm btn-outline-danger" type="submit">{{ trans('trainer.lists.delete') }}</button>
                        </form>
                    </div>
                </li>
            {% else %}
                <li class="list-group-item">{{ trans('trainer.lists.empty_courses') }}</li>
            {% endfor %}
        </ul>
    </div>
    <div class="col-lg-6">
        <h2 class="h5">{{ trans('trainer.lists.workshops') }}</h2>
        <ul class="list-group">
            {% for workshop in workshops %}
                <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                    <div class="flex-grow-1">
                        <a class="text-decoration-none" href="{{ path('atelier/' ~ workshop.id) }}">
                            {{ workshop.title }}
                        </a>
                        <div class="small text-muted">{{ workshop.scheduledAt|date(date_format) }}</div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-info text-dark text-uppercase">{{ workshop.status }}</span>
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('formateur', {'edit_workshop': workshop.id}) }}">{{ trans('trainer.lists.edit') }}</a>
                        <form method="post" action="{{ path('formateur') }}" onsubmit="return confirm('{{ trans('trainer.lists.confirm_workshop') }}');">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                            <input type="hidden" name="action" value="delete_workshop">
                            <input type="hidden" name="workshop_id" value="{{ workshop.id }}">
                            <button class="btn btn-sm btn-outline-danger" type="submit">{{ trans('trainer.lists.delete') }}</button>
                        </form>
                    </div>
                </li>
            {% else %}
                <li class="list-group-item">{{ trans('trainer.lists.empty_workshops') }}</li>
            {% endfor %}
        </ul>
    </div>
</div>
{% endblock %}
